{
    "layer": "top",
    "position": "bottom",
    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/idle", "custom/record", "custom/nightlight", "custom/weather", "network", "bluetooth", "cpu", "memory", "disk", "battery#bat0", "battery#bat1", "tray"],

    "sway/workspaces": {
        "disable-scroll": true
    },

    "clock": {
        "format": "{:%Y-%m-%d %H:%M:%S}",
        "interval": 1
    },

    "network": {
        "format-wifi": "Wi-Fi: {essid} {signalStrength}%",
        "format-ethernet": "ETH: {ipaddr}",
        "format-linked": "ETH (no IP)",
        "format-disconnected": "Disconnected",
        "on-click": "~/.local/bin/personal-tui wifi"
    },

    "bluetooth": {
        "format": "BT",
        "format-connected": "BT: {device_alias}",
        "format-off": "",
        "on-click": "~/.local/bin/personal-tui bluetooth"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "MEM {used:0.1f}G",
        "interval": 5
    },

    "disk": {
        "format": "/ {free}",
        "path": "/"
    },

    "battery#bat0": {
        "bat": "BAT0",
        "format": "Bat0: {status} {capacity}% {time}",
        "format-charging": "Bat0: ↑{capacity}%",
        "format-full": "Bat0: full",
        "format-not-charging": "Bat0: {capacity}%",
        "states": { "warning": 30, "critical": 15 }
    },

    "battery#bat1": {
        "bat": "BAT1",
        "format": "Bat1: {status} {capacity}% {time}",
        "format-charging": "Bat1: ↑{capacity}%",
        "format-full": "Bat1: full",
        "format-not-charging": "Bat1: {capacity}%",
        "states": { "warning": 30, "critical": 15 }
    },

    "tray": {
        "spacing": 10
    },

    "custom/weather": {
        "exec": "~/.local/bin/personal-weather",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true
    },

    "custom/idle": {
        "exec": "~/.local/bin/personal-idle status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "on-click": "~/.local/bin/personal-idle toggle"
    },

    "custom/nightlight": {
        "exec": "~/.local/bin/personal-nightlight status",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "~/.local/bin/personal-nightlight toggle"
    },

    "custom/record": {
        "exec": "~/.local/bin/personal-record status",
        "return-type": "json",
        "interval": 30,
        "signal": 10,
        "on-click": "~/.local/bin/personal-record toggle"
    }
}
