* {
    font-family: monospace;
    font-size: 12px;
    border: none;
    border-radius: 0;
    min-height: 20px;
}

window#waybar {
    background-color: @bg@;
    color: @fg@;
}

#workspaces button {
    padding: 0 5px;
    background-color: transparent;
    color: @fg_muted@;
}

#workspaces button.focused {
    background-color: @accent@;
    color: @fg@;
}

#workspaces button:hover {
    background-color: @bg_hover@;
}

#clock {
    padding: 0 10px;
    color: @fg@;
}

#network {
    padding: 0 8px;
    color: @cyan@;
}

#bluetooth {
    padding: 0 8px;
    color: @magenta@;
}

#cpu {
    padding: 0 8px;
    color: @green@;
}

#memory {
    padding: 0 8px;
    color: @yellow@;
}

#disk {
    padding: 0 8px;
    color: @orange@;
}

#battery {
    padding: 0 8px;
    color: @teal@;
}

#battery.warning {
    color: @warn@;
}

#battery.critical {
    color: @red@;
}

#network.disconnected {
    color: @red@;
}

#tray {
    padding: 0 8px;
}

#custom-idle.off {
    padding: 0 8px;
    color: @bg@;
    background-color: @yellow@;
}

#custom-nightlight.on {
    padding: 0 8px;
    color: @bg@;
    background-color: @orange@;
}

#custom-record.on {
    padding: 0 8px;
    color: @fg@;
    background-color: @red_soft@;
}
