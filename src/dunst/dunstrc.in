[global]
    font = Monospace 11
    format = "<b>%s</b>\n%b"
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "@border@"
    markup = full
    follow = mouse
    layer = top
    pause_on_mouse_over = true
    history_length = 30
    mouse_left_click = open_url, close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "@bg_alt@"
    foreground = "@fg_muted@"
    timeout = 10

[urgency_normal]
    background = "@accent@"
    foreground = "@fg@"
    timeout = 10

[urgency_critical]
    background = "@crit_bg@"
    foreground = "@fg@"
    frame_color = "@crit_frame@"
    timeout = 0
