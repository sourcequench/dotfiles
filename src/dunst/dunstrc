[global]
    font = Monospace 11
    format = "<b>%s</b>\n%b"
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "#aaaaaa"
    markup = full
    follow = mouse
    layer = top
    pause_on_mouse_over = true
    history_length = 30
    mouse_left_click = open_url, close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#222222"
    foreground = "#888888"
    timeout = 10

[urgency_normal]
    background = "#285577"
    foreground = "#ffffff"
    timeout = 10

[urgency_critical]
    background = "#900000"
    foreground = "#ffffff"
    frame_color = "#ff0000"
    timeout = 0
