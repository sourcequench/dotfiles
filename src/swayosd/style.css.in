/* Generated by personal-theme from the current palette. */
window#osd {
  border-radius: 12px;
  border: 2px solid @border@;
  background: alpha(@bg@, 0.94); }
  window#osd #container {
    margin: 16px; }
  window#osd image,
  window#osd label {
    color: @fg@; }
  window#osd progressbar:disabled,
  window#osd image:disabled {
    opacity: 0.5; }
  window#osd progressbar,
  window#osd segmentedprogress {
    min-height: 6px;
    border-radius: 999px;
    background: transparent;
    border: none; }
  window#osd trough,
  window#osd segment {
    min-height: inherit;
    border-radius: inherit;
    border: none;
    background: @bg_hover@; }
  window#osd progress,
  window#osd segment.active {
    min-height: inherit;
    border-radius: inherit;
    border: none;
    background: @accent_border@; }
