#!/bin/sh
# Stable short fortune for ~2 hours, for the tmux status bar.
cache="${XDG_RUNTIME_DIR:-/tmp}/personal-tmux-fortune"

now=$(date +%s)
age=9999
if [ -f "$cache" ]; then
    mtime=$(stat -c%Y "$cache" 2>/dev/null || echo 0)
    age=$(( now - mtime ))
fi

if [ "$age" -lt 7200 ]; then
    cat "$cache" 2>/dev/null
    exit 0
fi

text=$(fortune -s 2>/dev/null | tr '\t\n' '  ' | sed 's/  */ /g; s/^ //; s/ $//')
[ -z "$text" ] && exit 0

# Clean word-boundary truncation around 72 chars
if [ "${#text}" -gt 72 ]; then
    text=$(printf '%s' "$text" | cut -c1-72 | sed 's/ [^ ]*$//')…
fi

printf '%s' "$text" > "$cache" 2>/dev/null || true
printf '%s' "$text"
