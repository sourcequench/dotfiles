#!/bin/sh
set -eu
missing=0
check() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'missing command: %s\n' "$1"
        missing=1
    fi
}
check tmux
check python3
check kitty
check dunst
check i3status
check wpctl
check brightnessctl
check gsettings
check inputplug
check nm-applet
check blueman-applet
check i3
check xss-lock
check i3lock
check maim
check xclip
check dmenu_run
check waybar
check sway
check swayidle
check swaylock
check grim
check slurp
check wl-copy
if ! command -v wmenu-run >/dev/null 2>&1 && ! command -v fuzzel >/dev/null 2>&1 && ! command -v tofi >/dev/null 2>&1; then
    echo 'missing command: one of wmenu-run, fuzzel, or tofi'
    missing=1
fi
exit "$missing"
