#!/bin/sh
set -eu

runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
umask 077
status_config=$(mktemp "$runtime_dir/personal-i3status.XXXXXX")
status_pid=
cleanup() {
    if [ -n "$status_pid" ]; then
        kill "$status_pid" 2>/dev/null || true
        wait "$status_pid" 2>/dev/null || true
    fi
    rm -f "$status_config"
}
trap cleanup EXIT HUP INT TERM

cat > "$status_config" <<'EOF'
general {
    output_format = "i3bar"
    colors = true
    interval = 5
}
EOF

battery_index=0
for supply in /sys/class/power_supply/*; do
    [ -r "$supply/type" ] || continue
    [ "$(cat "$supply/type")" = Battery ] || continue
    [ -r "$supply/uevent" ] || continue
    name=${supply##*/}
    {
        printf 'order += "battery %s"\n' "$battery_index"
        printf 'battery %s {\n' "$battery_index"
        printf '    path = "%s/uevent"\n' "$supply"
        printf '    format = "%s: %%status %%percentage %%remaining"\n' "$name"
        printf '    last_full_capacity = true\n'
        printf '}\n'
    } >> "$status_config"
    battery_index=$((battery_index + 1))
done

has_wireless=false
for wireless_dir in /sys/class/net/*/wireless; do
    [ -d "$wireless_dir" ] || continue
    has_wireless=true
    break
done

if [ "$has_wireless" = true ]; then
    cat >> "$status_config" <<'EOF'
order += "wireless _first_"
wireless _first_ {
    format_up = "Wi-Fi: %essid %quality"
    format_down = "Wi-Fi: disconnected"
}
EOF
fi

cat >> "$status_config" <<'EOF'
order += "cpu_usage"
cpu_usage {
    format = "CPU %usage"
}
order += "memory"
memory {
    format = "MEM %used"
}
order += "disk /"
disk "/" {
    format = "/ %avail"
}
order += "tztime local"
tztime local {
    format = "%Y-%m-%d %H:%M:%S"
}
EOF

i3status --config "$status_config" | "$HOME/.local/bin/personal-status-color" &
status_pid=$!
wait "$status_pid"
