#!/bin/sh
# Lock the screen, skipping if on a trusted network.
# Trusted: any wired ethernet, or WiFi in TRUSTED_SSIDS.
set -eu

TRUSTED_SSIDS="skillet Fios-3RmbM"

_skip() {
    # Release xss-lock's sleep inhibitor fd (i3/X11 path) so sleep can proceed.
    [ -n "${XSS_SLEEP_LOCK_FD:-}" ] && eval "exec ${XSS_SLEEP_LOCK_FD}>&-"
    exit 0
}

if nmcli -t -f TYPE,STATE dev 2>/dev/null | grep -q '^ethernet:connected'; then
    _skip
fi

current_ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^yes:' | sed 's/^yes://' | head -1)
for ssid in $TRUSTED_SSIDS; do
    [ "$current_ssid" = "$ssid" ] && _skip
done

if [ -n "${SWAYSOCK:-}" ] || [ "${XDG_SESSION_TYPE:-}" = wayland ]; then
    # Colors come from the current theme; fall back to the original look.
    [ -r "$HOME/.config/personal-dotfiles/palette.sh" ] && . "$HOME/.config/personal-dotfiles/palette.sh"
    _c() { eval "v=\${$1:-$2}"; printf '%s' "${v#\#}"; }
    exec swaylock \
        --daemonize \
        --color "$(_c lock_bg '#1a1a2e')" \
        --inside-color "$(_c lock_inside '#1e1e2e')88" \
        --ring-color "$(_c accent '#285577')ff" \
        --ring-ver-color "$(_c cyan '#88c0d0')ff" \
        --ring-wrong-color "$(_c red_soft '#bf616a')ff" \
        --key-hl-color "$(_c cyan '#88c0d0')ff" \
        --bs-hl-color "$(_c yellow '#ebcb8b')ff" \
        --text-color "$(_c fg_soft '#e5e9f0')ff" \
        --separator-color 00000000 \
        --indicator-radius 80 \
        --indicator-thickness 8
else
    [ -r "$HOME/.config/personal-dotfiles/palette.sh" ] && . "$HOME/.config/personal-dotfiles/palette.sh"
    exec i3lock -c "$(printf '%s' "${lock_bg:-#1a1a2e}" | tr -d '#')" -n
fi
