#!/bin/sh
# Install signal-desktop, helium, and obsidian on machines where apt repos cannot be added.
# If the packages are already managed by apt, this script skips them.
# Stores the installed package version in ~/.local/state/personal-apps/.
set -eu

state_dir="$HOME/.local/state/personal-apps"
mkdir -p "$state_dir" "$HOME/.local/bin" "$HOME/.local/share/applications" "$HOME/bin"
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

package_metadata() {
    gzip -dc "$1" | awk -v wanted="$2" '
        BEGIN { RS = ""; FS = "\n" }
        $1 == "Package: " wanted {
            version = ""
            filename = ""
            for (i = 1; i <= NF; i++) {
                if ($i ~ /^Version: /) {
                    version = $i
                    sub(/^Version: /, "", version)
                }
                if ($i ~ /^Filename: /) {
                    filename = $i
                    sub(/^Filename: /, "", filename)
                }
            }
            if (version != "" && filename != "") {
                print version
                print filename
                exit
            }
        }
    '
}

package_is_current() {
    payload=$1
    version_file=$2
    legacy_url_file=$3
    latest_version=$4
    latest_url=$5

    [ -x "$payload" ] || return 1
    if [ -r "$version_file" ] && \
            dpkg --compare-versions "$(cat "$version_file")" ge "$latest_version"; then
        return 0
    fi
    if [ -r "$legacy_url_file" ] && [ "$(cat "$legacy_url_file")" = "$latest_url" ]; then
        printf '%s\n' "$latest_version" > "$version_file"
        return 0
    fi
    return 1
}

configure_signal() {
    ln -sf "$HOME/bin/opt/Signal/signal-desktop" "$HOME/.local/bin/signal-desktop"
    for f in "$HOME/bin/opt/Signal/"*.desktop \
              "$HOME/bin/usr/share/applications/signal-desktop.desktop"; do
        [ -f "$f" ] && cp "$f" "$HOME/.local/share/applications/signal-desktop.desktop" && break
    done
}

configure_helium() {
    ln -sf "$HOME/bin/opt/helium/helium-wrapper" "$HOME/.local/bin/helium"
    desktop_src="$HOME/bin/opt/helium/helium.desktop"
    [ -f "$desktop_src" ] && cp "$desktop_src" "$HOME/.local/share/applications/helium.desktop"
}

configure_obsidian() {
    ln -sf "$HOME/.local/bin/personal-obsidian" "$HOME/.local/bin/obsidian"
    for f in "$HOME/bin/usr/share/applications/obsidian.desktop" \
             /usr/share/applications/obsidian.desktop; do
        if [ -f "$f" ]; then
            cp "$f" "$HOME/.local/share/applications/obsidian.desktop"
            if [ -x "$HOME/bin/opt/Obsidian/obsidian" ]; then
                sed -i 's|^Exec=/opt/Obsidian/obsidian|Exec='"$HOME"'/bin/opt/Obsidian/obsidian|' \
                    "$HOME/.local/share/applications/obsidian.desktop"
            fi
            break
        fi
    done
}

install_signal() {
    # Only skip if our apt repo is configured — dpkg status alone is unreliable
    # (old installs can leave ii entries even when the repo is gone)
    if [ -f /etc/apt/sources.list.d/signal-xenial.sources ] || \
       [ -f /etc/apt/sources.list.d/signal-xenial.list ]; then
        return 0
    fi
    index="$work_dir/signal-packages.gz"
    curl -fsSL -o "$index" \
        'https://updates.signal.org/desktop/apt/dists/xenial/main/binary-amd64/Packages.gz'
    metadata=$(package_metadata "$index" signal-desktop)
    latest_version=$(printf '%s\n' "$metadata" | sed -n '1p')
    filename=$(printf '%s\n' "$metadata" | sed -n '2p')
    [ -n "$latest_version" ] && [ -n "$filename" ] || \
        { echo 'personal-apps-install: cannot determine Signal version' >&2; return 1; }
    latest_url="https://updates.signal.org/desktop/apt/$filename"
    version_file="$state_dir/signal-version"
    if package_is_current "$HOME/bin/opt/Signal/signal-desktop" "$version_file" \
            "$state_dir/signal-url" "$latest_version" "$latest_url"; then
        configure_signal
        return 0
    fi
    printf 'Installing Signal %s from %s\n' "$latest_version" "$latest_url"
    curl -fsSL -o "$work_dir/signal.deb" "$latest_url"
    dpkg-deb -x "$work_dir/signal.deb" "$HOME/bin"
    configure_signal
    printf '%s\n' "$latest_version" > "$version_file"
    echo 'Signal installed.'
}

install_helium() {
    if [ -f /etc/apt/sources.list.d/helium.sources ]; then
        return 0
    fi
    index="$work_dir/helium-packages.gz"
    curl -fsSL -o "$index" \
        'https://pkg.helium.computer/deb/dists/stable/main/binary-amd64/Packages.gz'
    metadata=$(package_metadata "$index" helium-bin)
    latest_version=$(printf '%s\n' "$metadata" | sed -n '1p')
    filename=$(printf '%s\n' "$metadata" | sed -n '2p')
    [ -n "$latest_version" ] && [ -n "$filename" ] || \
        { echo 'personal-apps-install: cannot determine Helium version' >&2; return 1; }
    latest_url="https://pkg.helium.computer/deb/$filename"
    version_file="$state_dir/helium-version"
    if package_is_current "$HOME/bin/opt/helium/helium-wrapper" "$version_file" \
            "$state_dir/helium-url" "$latest_version" "$latest_url"; then
        configure_helium
        return 0
    fi
    printf 'Installing Helium %s from %s\n' "$latest_version" "$latest_url"
    curl -fsSL -o "$work_dir/helium.deb" "$latest_url"
    dpkg-deb -x "$work_dir/helium.deb" "$HOME/bin"
    configure_helium
    printf '%s\n' "$latest_version" > "$version_file"
    echo 'Helium installed.'
}

install_obsidian() {
    # Skip download if already installed by apt / system package
    if [ -x /usr/bin/obsidian ] && dpkg -s obsidian >/dev/null 2>&1; then
        configure_obsidian
        return 0
    fi
    tag=$(curl -fsSLI -A "Mozilla/5.0 (X11; Linux x86_64)" -o /dev/null -w "%{url_effective}" https://github.com/obsidianmd/obsidian-releases/releases/latest 2>/dev/null | sed 's|.*/tag/v||')
    if [ -z "$tag" ]; then
        tag=$(curl -fsSL -A "Mozilla/5.0 (X11; Linux x86_64)" https://api.github.com/repos/obsidianmd/obsidian-releases/releases/latest 2>/dev/null | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')
    fi
    if [ -z "$tag" ]; then
        tag="1.15.1"
    fi
    latest_version="$tag"
    latest_url="https://github.com/obsidianmd/obsidian-releases/releases/download/v${tag}/obsidian_${tag}_amd64.deb"
    version_file="$state_dir/obsidian-version"
    if package_is_current "$HOME/bin/opt/Obsidian/obsidian" "$version_file" \
            "$state_dir/obsidian-url" "$latest_version" "$latest_url"; then
        configure_obsidian
        return 0
    fi
    printf 'Installing Obsidian %s from %s\n' "$latest_version" "$latest_url"
    if curl -fsSL -A "Mozilla/5.0 (X11; Linux x86_64)" -o "$work_dir/obsidian.deb" "$latest_url"; then
        dpkg-deb -x "$work_dir/obsidian.deb" "$HOME/bin"
        chmod +x "$HOME/bin/opt/Obsidian/obsidian" 2>/dev/null || true
        configure_obsidian
        printf '%s\n' "$latest_version" > "$version_file"
        echo 'Obsidian installed.'
    else
        echo 'personal-apps-install: cannot download Obsidian deb' >&2
        return 1
    fi
}

install_signal || echo 'personal-apps-install: Signal installation failed' >&2
install_helium || echo 'personal-apps-install: Helium installation failed' >&2
install_obsidian || echo 'personal-apps-install: Obsidian installation failed' >&2
