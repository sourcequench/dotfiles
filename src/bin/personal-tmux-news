#!/usr/bin/env python3
"""Print a cached Hacker News headline and refresh it outside tmux's redraw path."""

import html
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import urllib.request


SOURCE = "hacker-news"
API_ROOT = "https://hacker-news.firebaseio.com/v0"
REFRESH_SECONDS = 30 * 60
LOCK_SECONDS = 60
MAX_TITLE_LENGTH = 88

cache_root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
cache_dir = cache_root / "personal-dotfiles"
cache_file = cache_dir / "tmux-news.json"
lock_file = cache_dir / "tmux-news.lock"


def read_cache():
    try:
        return json.loads(cache_file.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def shorten(text):
    text = " ".join(html.unescape(text).split())
    if len(text) <= MAX_TITLE_LENGTH:
        return text
    shortened = text[: MAX_TITLE_LENGTH - 1].rsplit(" ", 1)[0]
    return f"{shortened}…"


def refresh():
    cache_dir.mkdir(parents=True, exist_ok=True)
    try:
        if lock_file.exists() and time.time() - lock_file.stat().st_mtime > LOCK_SECONDS:
            lock_file.unlink()
        lock_fd = os.open(lock_file, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(lock_fd)
    except (FileExistsError, OSError):
        return

    data = read_cache()
    if data.get("source") != SOURCE:
        data = {}
    data["source"] = SOURCE
    data["attempted"] = int(time.time())
    try:
        request = urllib.request.Request(
            f"{API_ROOT}/topstories.json",
            headers={"User-Agent": "personal-tmux-news/1.0"},
        )
        with urllib.request.urlopen(request, timeout=10) as response:
            story_ids = json.load(response)
        if not isinstance(story_ids, list) or not story_ids:
            raise ValueError("top stories response is empty")
        story_id = int(story_ids[0])

        request = urllib.request.Request(
            f"{API_ROOT}/item/{story_id}.json",
            headers={"User-Agent": "personal-tmux-news/1.0"},
        )
        with urllib.request.urlopen(request, timeout=10) as response:
            item = json.load(response)
        if not isinstance(item, dict):
            raise ValueError("story response is invalid")
        title = item.get("title", "").strip()
        if not title:
            raise ValueError("headline is empty")
        data["title"] = title
        data["link"] = f"https://news.ycombinator.com/item?id={story_id}"
        data["updated"] = int(time.time())
    except (IndexError, KeyError, OSError, TypeError, ValueError):
        pass

    try:
        temporary = cache_file.with_suffix(".tmp")
        temporary.write_text(json.dumps(data), encoding="utf-8")
        os.replace(temporary, cache_file)
    except OSError:
        pass
    finally:
        try:
            lock_file.unlink()
        except OSError:
            pass


def start_refresh():
    subprocess.Popen(
        [sys.executable, __file__, "--refresh"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        close_fds=True,
    )


if __name__ == "__main__":
    if sys.argv[1:] == ["--refresh"]:
        refresh()
        raise SystemExit

    cached = read_cache()
    if cached.get("source") != SOURCE:
        cached = {}
    attempted = cached.get("attempted", cached.get("updated", 0))
    if time.time() - attempted >= REFRESH_SECONDS:
        start_refresh()

    title = cached.get("title")
    if title:
        # A literal # must be doubled so tmux does not parse feed text as formatting.
        print(f"HN: {shorten(title)}".replace("#", "##"), end="")
    else:
        print("HN: loading news...", end="")
