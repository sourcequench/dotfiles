#!/bin/sh
if [ -x /usr/bin/obsidian ]; then
    exec /usr/bin/obsidian "$@"
fi
if command -v obsidian >/dev/null 2>&1; then
    exec obsidian "$@"
fi
if [ -x "$HOME/bin/opt/Obsidian/obsidian" ]; then
    exec "$HOME/bin/opt/Obsidian/obsidian" "$@"
fi
if [ -x "$HOME/.local/bin/obsidian" ]; then
    exec "$HOME/.local/bin/obsidian" "$@"
fi
echo 'personal-obsidian: obsidian not found' >&2
exit 1
