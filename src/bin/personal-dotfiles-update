#!/bin/sh
set -eu

# Ensure standard user paths are in PATH even when run from cron
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Ensure user systemd and dbus access when run from cron
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

force=0
for arg in "$@"; do
    if [ "$arg" = "--force" ] || [ "$arg" = "-f" ]; then
        force=1
    fi
done

repo=${PERSONAL_DOTFILES_REPO:-"$HOME/.local/share/personal-dotfiles"}

if [ ! -d "$repo/.git" ]; then
    echo "Dotfiles checkout not found at $repo" >&2
    exit 1
fi

git -C "$repo" pull --ff-only
commit=$(git -C "$repo" rev-parse HEAD)
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/personal-dotfiles
state_file=$state_dir/auto-updated
if [ "$force" -eq 0 ] && [ -r "$state_file" ] && [ "$(cat "$state_file")" = "$commit" ]; then
    echo "Dotfiles are already applied at $commit"
    exit 0
fi

"$repo/install" "$@"
mkdir -p "$state_dir"
printf '%s\n' "$commit" > "$state_file"
