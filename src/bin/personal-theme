#!/usr/bin/python3
"""Render desktop colors from one palette.

Usage: personal-theme apply | set NAME | list | current

  apply    render the current theme into the config files (no reloads)
  set      switch theme, render, and reload waybar, dunst, kitty, swayosd and the window manager
  list     show installed themes
  current  show the current theme name

Themes are sh-sourceable files of name="#rrggbb" lines in
~/.config/personal-dotfiles/themes. Templates use @name@ placeholders.
"""
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config", "personal-dotfiles")
THEMES = os.path.join(CFG, "themes")
TEMPLATES = os.path.join(CFG, "templates")
STATE = os.path.join(CFG, "theme")
PALETTE = os.path.join(CFG, "palette.sh")
DEFAULT = "default"

# template file -> rendered destination
OUTPUTS = {
    "waybar-style.css": os.path.join(HOME, ".config", "waybar", "style.css"),
    "dunstrc": os.path.join(HOME, ".config", "dunst", "dunstrc"),
    "colors.conf": os.path.join(CFG, "colors.conf"),
    "kitty-colors.conf": os.path.join(CFG, "kitty-colors.conf"),
    "swayosd-style.css": os.path.join(HOME, ".config", "swayosd", "style.css"),
}


def die(msg):
    sys.stderr.write("personal-theme: %s\n" % msg)
    sys.exit(1)


def theme_names():
    try:
        return sorted(f[:-3] for f in os.listdir(THEMES) if f.endswith(".sh"))
    except OSError:
        return []


def current():
    try:
        with open(STATE) as f:
            name = f.read().strip()
    except OSError:
        name = DEFAULT
    return name if name in theme_names() else DEFAULT


def load_palette(name):
    path = os.path.join(THEMES, name + ".sh")
    palette = {}
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r'^([a-z_]+)="(#[0-9a-fA-F]{6})"\s*$', line)
                if m:
                    palette[m.group(1)] = m.group(2)
    except OSError:
        die("cannot read theme %s" % path)
    return palette


def render(name):
    palette = load_palette(name)
    shutil.copyfile(os.path.join(THEMES, name + ".sh"), PALETTE)
    for tmpl, dest in OUTPUTS.items():
        try:
            with open(os.path.join(TEMPLATES, tmpl)) as f:
                text = f.read()
        except OSError:
            die("missing template %s" % tmpl)
        unknown = set(re.findall(r"@([a-z_]+)@", text)) - set(palette)
        if unknown:
            die("theme %s lacks colors: %s" % (name, ", ".join(sorted(unknown))))
        out = re.sub(r"@([a-z_]+)@", lambda m: palette[m.group(1)], text)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        tmp = dest + ".tmp"
        with open(tmp, "w") as f:
            f.write(out)
        os.replace(tmp, dest)


def reload_running():
    subprocess.call(["pkill", "-USR2", "-x", "-u", str(os.getuid()), "waybar"],
                    stderr=subprocess.DEVNULL)
    # SIGUSR1 makes running kitty windows re-read their config.
    subprocess.call(["pkill", "-USR1", "-x", "-u", str(os.getuid()), "kitty"],
                    stderr=subprocess.DEVNULL)
    # swayosd reads its stylesheet at startup, so restart it if it is running.
    if subprocess.call(["pgrep", "-x", "-u", str(os.getuid()), "swayosd-server"],
                       stdout=subprocess.DEVNULL) == 0:
        subprocess.call(["pkill", "-x", "-u", str(os.getuid()), "swayosd-server"])
        subprocess.Popen(["swayosd-server"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    subprocess.call(["dunstctl", "reload"], stderr=subprocess.DEVNULL)
    wm = "swaymsg" if os.environ.get("SWAYSOCK") else "i3-msg"
    subprocess.call([wm, "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "apply":
        render(current())
    elif cmd == "set":
        if len(argv) != 3:
            die("usage: personal-theme set NAME")
        if argv[2] not in theme_names():
            die("unknown theme %r (have: %s)" % (argv[2], ", ".join(theme_names())))
        render(argv[2])
        with open(STATE, "w") as f:
            f.write(argv[2] + "\n")
        reload_running()
    elif cmd == "list":
        cur = current()
        for n in theme_names():
            print(("* " if n == cur else "  ") + n)
    elif cmd == "current":
        print(current())
    else:
        sys.stderr.write(__doc__)
        sys.exit(2)


main(sys.argv)
