#!/bin/sh
# Outputs the tmux status-right for the focused pane.
# Args: pane_current_path  pane_pid  window_panes
pane_path=${1:-$HOME}
pane_pid=${2:-}
pane_count=${3:-1}

sep='#[fg=colour238] │ '

# --- Path (shorten deep trees) ---
short=$(printf '%s' "$pane_path" | sed "s|^$HOME|~|")
depth=$(printf '%s' "$short" | awk -F/ '{print NF - 1}')
if [ "$depth" -gt 3 ]; then
    tail=$(printf '%s' "$short" | rev | cut -d/ -f1-2 | rev)
    short="~/../$tail"
fi
out="#[fg=colour75,bold]$short#[nobold]"

# --- Git branch + dirty marker ---
if cd "$pane_path" 2>/dev/null && git rev-parse --git-dir >/dev/null 2>&1; then
    branch=$(git branch --show-current 2>/dev/null)
    [ -z "$branch" ] && branch=$(git rev-parse --short HEAD 2>/dev/null)
    dirty=$(git status --short --untracked-files=no 2>/dev/null | head -1)
    [ -n "$dirty" ] && marker='#[fg=colour196] ●' || marker='#[fg=colour238] ○'
    out="${out}${sep}#[fg=colour226]⎇ ${branch}${marker}#[default]"
fi

# --- AI agent detection ---
agent=''
color='colour82'
if [ -n "$pane_pid" ]; then
    args=$(ps --ppid "$pane_pid" -o args= 2>/dev/null | tr '\n' ' ')
    cmd=$(ps -p "$pane_pid" -o comm= 2>/dev/null)
    combined="$args $cmd"
    case "$combined" in
        *claude-code*|*@anthropic-ai/claude*) agent='✦ claude code'; color='colour208' ;;
        *claude*)  agent='✦ claude';      color='colour208' ;;
        *codex*)   agent='⬡ codex';       color='colour39'  ;;
        *goose*)   agent='🪿 goose';      color='colour214' ;;
        *gemini*)  agent='♊ gemini';      color='colour75'  ;;
        *aider*)   agent='⚡ aider';      color='colour226' ;;
        *cursor*)  agent='⬡ cursor';      color='colour39'  ;;
    esac
fi
[ -n "$agent" ] && out="${out}${sep}#[fg=${color},bold]${agent}#[nobold,default]"

# --- Pane count (only if > 1) ---
if [ "${pane_count:-1}" -gt 1 ] 2>/dev/null; then
    out="${out}${sep}#[fg=colour214]${pane_count}⊞#[default]"
fi

printf '%s ' "$out"
