[Unit]
Description=Obsidian Headless Sync
After=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'rm -f %h/.config/obsidian/Singleton*'
ExecStart=/usr/bin/obsidian %h/md --ozone-platform=headless --disable-gpu --no-sandbox
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
